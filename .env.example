# Client-side configuration only.
# Do not put SMTP passwords, Cloudinary API secrets, or other private credentials in this file.
# Copy to .env.local and fill in the public values when EmailJS and Cloudinary are ready.

# EmailJS — public values from the EmailJS dashboard, used by the contact form.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Cloudinary — unsigned upload preset only. Never add CLOUDINARY_API_SECRET.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
