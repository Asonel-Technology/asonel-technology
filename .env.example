# Client-side configuration only.
# Do not put SMTP passwords, Cloudinary API secrets, or other private credentials in this file.
# Copy to .env.local and fill in the public values when EmailJS and Cloudinary are ready.

# EmailJS — public values from the EmailJS dashboard, used by the contact form.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Cloudinary — unsigned upload preset only. Never add CLOUDINARY_API_SECRET.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Public video URL for the About section. Leave empty to keep the photograph.
VITE_CLOUDINARY_ABOUT_VIDEO_URL=
# Cloudinary — public values only. NEVER add CLOUDINARY_API_SECRET here (server-side only).
VITE_CLOUDINARY_CLOUD_NAME=        # your cloud name, e.g. mycompany
VITE_CLOUDINARY_API_KEY=           # public API key from Cloudinary dashboard
VITE_CLOUDINARY_UPLOAD_PRESET=     # unsigned upload preset name (for browser uploads)
VITE_CLOUDINARY_ABOUT_VIDEO_URL=   # full Cloudinary video URL e.g. https://res.cloudinary.com/<cloud>/video/upload/about-intro.mp4
VITE_CLOUDINARY_ABOUT_VIDEO_URL=   # full Cloudinary video URL for the about section, e.g. https://res.cloudinary.com/<cloud>/video/upload/about-intro.mp4
